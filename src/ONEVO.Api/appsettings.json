{
  "AllowedHosts": "*",
  "AllowedOrigins": [ "http://localhost:5173", "https://app.onevo.com" ],
  "Jwt": {
    "TenantIssuer": "onevo-api",
    "TenantAudience": "onevo-api"
  },
  "TrayApp": {
    "Jwt": {
      "Issuer": "onevo-tray",
      "Audience": "onevo-tray-app"
    }
  },
  "Urls": {
    "AppBaseUrl": "",
    "AdminConsoleBaseUrl": "",
    "WebhookBaseUrl": ""
  },
  "Email": {
    "FromAddress": "",
    "FromName": "ONEVO",
    "ReplyToEmail": "",
    "AppBaseUrl": "",
    "AdminConsoleBaseUrl": ""
  },
  "Tenancy": {
    "RootDomain": ""
  },
  "Leave": {
    "Entitlements": {
      "Years": {
        "MinimumYear": 2020,
        "MaximumYear": 2035
      }
    },
    "Requests": {
      "AllowBackdatedRequests": false,
      "AllowUnpaidSplitWhenBalanceShort": false,
      "RequireReason": false,
      "MaximumRequestRangeDays": 3660
    },
    "Approvals": {
      "AllowSelfApproval": false
    }
  },
  "AwsRekognition": {
    "Region": "us-east-1",
    "LivenessRoleArn": "arn:aws:iam::000000000000:role/face-liveness",
    "LivenessConfidenceThreshold": 90,
    "RoleSessionDurationSeconds": 900,
    "SessionTtlMinutes": 3
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}
