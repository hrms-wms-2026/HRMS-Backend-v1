{
  "AllowedHosts": "*",
  "AllowedOrigins": [ "http://localhost:5173", "https://app.onevo.com" ],
  "Jwt": {
    "TenantIssuer": "onevo-api",
    "TenantAudience": "onevo-api"
  },
  "TrayApp": {
    "Jwt": {
      "Issuer": "onevo-tray",
      "Audience": "onevo-tray-app"
    }
  },
    "Urls": {
    "AppBaseUrl": "",
    "AdminConsoleBaseUrl": "",
    "WebhookBaseUrl": ""
  },
  "TrayPresence": {
    "Mode": "Observe",
    "GracePeriodSeconds": 120,
    "HeartbeatSeconds": 30,
    "AuthorizationRetentionDays": 30
  },
  "TrayInstaller": {
    "Version": "",
    "DownloadUrl": "",
    "Sha256": "",
    "Publisher": "",
    "MinimumWindowsVersion": ""
  },

  "Email": {
    "FromAddress": "",
    "FromName": "ONEVO",
    "ReplyToEmail": "",
    "AppBaseUrl": "",
    "AdminConsoleBaseUrl": ""
  },
  "Tenancy": {
    "RootDomain": ""
  },
  "Leave": {
    "Entitlements": {
      "Years": {
        "MinimumYear": 2020,
        "MaximumYear": 2035
      }
    },
    "Requests": {
      "AllowBackdatedRequests": false,
      "AllowUnpaidSplitWhenBalanceShort": false,
      "RequireReason": false,
      "MaximumRequestRangeDays": 3660
    },
    "Approvals": {
      "AllowSelfApproval": false
    },
    "Cancellation": {
      "FallbackTimezone": "UTC",
      "RequireEmployeeReason": false
    },
    "Calendar": {
      "DefaultIncludeTentativeBlocks": true,
      "TypeCategoryColors": {
        "annual": "#2563EB",
        "sick": "#16A34A",
        "maternity": "#DB2777",
        "paternity": "#7C3AED",
        "compassionate": "#64748B",
        "unpaid": "#EA580C",
        "custom": "#475569"
      }
    }
  },
  "AwsRekognition": {
    "Region": "us-east-1",
    "LivenessRoleArn": "arn:aws:iam::000000000000:role/face-liveness",
    "LivenessConfidenceThreshold": 90,
    "FaceMatchSimilarityThreshold": 80,
    "RoleSessionDurationSeconds": 900,
    "SessionTtlMinutes": 3
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}
