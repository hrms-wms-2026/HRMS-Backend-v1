{
  "AllowedHosts": "*",
  "AllowedOrigins": [ "http://localhost:5173", "https://app.onevo.com" ],
  "AdminCookieDomain": "",
  "Jwt": {
    "TenantIssuer": "onevo-api",
    "TenantAudience": "onevo-api"
  },
  "TrayApp": {
    "Jwt": {
      "Issuer": "onevo-tray",
      "Audience": "onevo-tray-app"
    }
  },
    "Urls": {
    "AppBaseUrl": "",
    "AdminConsoleBaseUrl": "",
    "WebhookBaseUrl": "",
    "CalendarOAuthCallbackBaseUrl": ""
  },
  "TrayPresence": {
    "Mode": "Enforce",
    "GracePeriodSeconds": 120,
    "HeartbeatSeconds": 30,
    "AuthorizationRetentionDays": 30
  },

  "TrayReleases": {
    "IngestToken": ""
  },

  "Email": {
    "FromAddress": "",
    "FromName": "ONEVO",
    "ReplyToEmail": "",
    "AppBaseUrl": "",
    "AdminConsoleBaseUrl": "",
    "MaxPerSecond": 0
  },
  "Tenancy": {
    "RootDomain": ""
  },
  "Leave": {
    "Entitlements": {
      "Years": {
        "MinimumYear": 2020,
        "MaximumYear": 2035
      }
    },
    "Requests": {
      "AllowBackdatedRequests": false,
      "RequireReason": false,
      "MaximumRequestRangeDays": 3660
    },
    "Approvals": {
      "AllowSelfApproval": false
    },
    "Cancellation": {
      "FallbackTimezone": "UTC",
      "RequireEmployeeReason": false
    },
    "Calendar": {
      "DefaultIncludeTentativeBlocks": true
    }
  },
  "Meetings": {
    "Create": false,
    "BulkInvite": false,
    "Background": false,
    "ReadOnly": false,
    "Attendance": {
      "Checkpoints": [ "00:30:00", "02:00:00", "1.00:00:00" ],
      "MatchWindowBefore": "01:00:00",
      "LateRecheckWindow": "7.00:00:00",
      "FailedRetryAfter": "3.00:00:00"
    },
    "ProviderCapacityWarning": {
      "MicrosoftTeams": 1000,
      "Zoom": 300
    }
  },
  "AwsRekognition": {
    "Region": "us-east-1",
    "LivenessRoleArn": "arn:aws:iam::000000000000:role/face-liveness",
    "LivenessConfidenceThreshold": 90,
    "FaceMatchSimilarityThreshold": 80,
    "MinBrightness": 40,
    "MaxBrightness": 95,
    "MinFaceConfidence": 90,
    "MinFaceBoxRatio": 0.12,
    "MaxHeadPoseDegrees": 35,
    "AccessoryConfidenceThreshold": 80,
    "RoleSessionDurationSeconds": 900,
    "SessionTtlMinutes": 3
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}
