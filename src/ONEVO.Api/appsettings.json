{
  "AllowedHosts": "*",
  "AllowedOrigins": [ "http://localhost:5173", "https://app.onevo.com" ],
  "Jwt": {
    "TenantIssuer": "onevo-api",
    "TenantAudience": "onevo-api",
    "AgentIssuer": "onevo",
    "Secret": "CHANGE_ME_tenant_secret_min_32_chars_!!",
    "AgentSecret": "CHANGE_ME_agent_secret_min_32_chars_!!"
  },
  "Auth": {
    "Mfa": {
      "AllowProcessLocalChallengeStore": false
    }
  },
  "Encryption": {
    "MasterKey": ""
  },
  "IdentityVerification": {
    "AwsRegion": "ap-south-1"
  },
  "Urls": {
    "AppBaseUrl": "",
    "AdminConsoleBaseUrl": "",
    "WebhookBaseUrl": ""
  },
  "Email": {
    "FromAddress": "",
    "FromName": "ONEVO",
    "ReplyToEmail": "",
    "AppBaseUrl": "",
    "AdminConsoleBaseUrl": ""
  },
  "Tenancy": {
    "RootDomain": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}
