  "TrayPresence": {
    "Mode": "Enforce",
    "GracePeriodSeconds": 120,
    "HeartbeatSeconds": 30,
    "AuthorizationRetentionDays": 30
  },

  "Swagger": {
    "Enabled": true
  },
  "Planner": {
    "Enabled": true
  },
  "Tenancy": {
    "RootDomain": "crownus.test"
  },
  "Leave": {
    "Entitlements": {
      "Years": {
        "MinimumYear": 2020,
        "MaximumYear": 2035
      }
    },
    "Requests": {
      "AllowBackdatedRequests": false,
      "RequireReason": false,
      "MaximumRequestRangeDays": 3660
    },
    "Approvals": {
      "AllowSelfApproval": false
    },
    "Cancellation": {
      "FallbackTimezone": "UTC",
      "RequireEmployeeReason": false
    },
    "Calendar": {
      "DefaultIncludeTentativeBlocks": true
    }
  },
  "AwsRekognition": {
    "Region": "us-east-1",
    "LivenessRoleArn": "arn:aws:iam::000000000000:role/dev-face-liveness",
    "LivenessConfidenceThreshold": 90,
    "FaceMatchSimilarityThreshold": 80,
    "MinBrightness": 40,
    "MaxBrightness": 95,
    "MinFaceConfidence": 90,
    "MinFaceBoxRatio": 0.12,
    "MaxHeadPoseDegrees": 35,
    "AccessoryConfidenceThreshold": 80,
    "RoleSessionDurationSeconds": 900,
    "SessionTtlMinutes": 3
  },
  "StorageQuota": {
    "DefaultStorageLimitGb": 5
  },
  "Kestrel": {
    "Certificates": {
      "Default": {
        "Path": "../../.certs/backend-crownus-cert.pem",
        "KeyPath": "../../.certs/backend-crownus-key.pem"
      }
    }
  },
  "AllowedOrigins": [
