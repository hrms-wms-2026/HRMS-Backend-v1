{
  "Jwt": {
    "TenantIssuer": "onevo-api",
    "TenantAudience": "onevo-api"
  },
  "TrayApp": {
    "Jwt": {
      "Secret": "dev-only-tray-jwt-secret-min-32-chars-replace-in-prod"
    }
  },
  "Email": {
    "FromAddress": "onboarding@resend.dev",
    "FromName": "ONEVO (Dev)",
    "ReplyToEmail": "",
    "AppBaseUrl": "https://localhost:4200",
    "AdminConsoleBaseUrl": "https://admin.localhost:4200"
  },
    "Urls": {
    "AppBaseUrl": "https://localhost:4200",
    "AdminConsoleBaseUrl": "https://admin.localhost:4200",
    "WebhookBaseUrl": ""
  },
  "TrayPresence": {
    "Mode": "Observe",
    "GracePeriodSeconds": 120,
    "HeartbeatSeconds": 30,
    "AuthorizationRetentionDays": 30
  },

  "Swagger": {
    "Enabled": true
  },
  "Tenancy": {
    "RootDomain": "localhost"
  },
  "Leave": {
    "Entitlements": {
      "Years": {
        "MinimumYear": 2020,
        "MaximumYear": 2035
      }
    },
    "Requests": {
      "AllowBackdatedRequests": false,
      "AllowUnpaidSplitWhenBalanceShort": false,
      "RequireReason": false,
      "MaximumRequestRangeDays": 3660
    },
    "Approvals": {
      "AllowSelfApproval": false
    },
    "Cancellation": {
      "FallbackTimezone": "UTC",
      "RequireEmployeeReason": false
    },
    "Calendar": {
      "DefaultIncludeTentativeBlocks": true,
      "TypeCategoryColors": {
        "annual": "#2563EB",
        "sick": "#16A34A",
        "maternity": "#DB2777",
        "paternity": "#7C3AED",
        "compassionate": "#64748B",
        "unpaid": "#EA580C",
        "custom": "#475569"
      }
    }
  },
  "AwsRekognition": {
    "Region": "us-east-1",
    "LivenessRoleArn": "arn:aws:iam::000000000000:role/dev-face-liveness",
    "LivenessConfidenceThreshold": 90,
    "FaceMatchSimilarityThreshold": 80,
    "RoleSessionDurationSeconds": 900,
    "SessionTtlMinutes": 3
  },
  "StorageQuota": {
    "DefaultStorageLimitGb": 5
  },
  "Kestrel": {
    "Certificates": {
      "Default": {
        "Path": "../../.certs/backend-localhost-cert.pem",
        "KeyPath": "../../.certs/backend-localhost-key.pem"
      }
    }
  },
  "AllowedOrigins": [
    "http://localhost:5173",
    "http://localhost:5174",
    "https://localhost:4200",
    "https://admin.localhost:4200"
  ],
  "PlatformBootstrap": {
    "SuperAdminEmail": "dapiyshanth1908@gmail.com",
    "SuperAdminFullName": "Dapiyshanth"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "System": "Information"
      }
    }
  }
}
