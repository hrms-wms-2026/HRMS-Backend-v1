# Crownus Backend local environment template
# Copy this file to the gitignored repository-root .env for local development.
# Keep real values only in local .env or an external secret manager.
#
# The API builds both .NET connection strings from these atomic CROWNUS_DB_* values.
# Do not add full ConnectionStrings__* assignments.
CROWNUS_DB_HOST=localhost
CROWNUS_DB_PORT=1433
CROWNUS_DB_NAME=CrownusDb
CROWNUS_DB_ADMIN_USER=sa
CROWNUS_DB_ADMIN_PASSWORD=<local-sqlserver-admin-password>
CROWNUS_DB_APP_USER=crownus_app
CROWNUS_DB_APP_PASSWORD=<local-runtime-password>
CROWNUS_DB_MIGRATOR_USER=crownus_migrator
CROWNUS_DB_MIGRATOR_PASSWORD=<local-migration-password>

# Pre-database cryptographic inputs (use independent random values, 32+ characters).
Encryption__MasterKey=<local-32-plus-character-random-secret>
Jwt__Secret=<local-32-plus-character-random-secret-if-required>
Jwt__AdminSecret=<local-32-plus-character-random-secret-if-required>
# Tray device-token signing keys (SEC-15): ECDSA P-256 (ES256), backend only; never ship them to
# the tray app. Leave these unset locally: Development/Test then sign with a throwaway key that
# changes on every restart (trays recover with one refresh). Required outside Development/Test.
# Generate: openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt
# Put the PEM on one line with literal \n between lines. See docs/deployment/tray-device-jwt.md.
# TrayApp__Jwt__SigningKeys__0__Kid=tray-local
# TrayApp__Jwt__SigningKeys__0__PrivateKeyPem=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# TrayApp__Jwt__ActiveKid=tray-local
#
# Cut-over only: accept tokens signed with the old HS256 secret until this UTC instant.
# TrayApp__Jwt__AcceptLegacyHs256Until=2026-11-20T12:00:00Z
# TrayApp__Jwt__Secret=<the-old-hs256-secret>

# One-time Development/Test Developer Platform bootstrap input.
# DevAdmin__Password is used only when the configured platform user has no active
# password credential. After platform_user_credentials exists, login uses the DB
# password hash and startup no longer requires this value. Outside Development/Test
# it is ignored unless PlatformBootstrap__AllowPasswordBootstrap=true is also set: a
# one-time opt-in for a fresh server's first admin. Remove both right after the first
# login, so a running server never depends on DevAdmin__Password.
PlatformBootstrap__SuperAdminEmail=dev@crownus.test
PlatformBootstrap__SuperAdminFullName=Development Super Admin
DevAdmin__Password=<one-time-local-dev-bootstrap-password>
# PlatformBootstrap__AllowPasswordBootstrap=true

# Non-secret email sender configuration. Provider API keys are not environment
# settings: save resend/sendgrid keys through the admin/system-config APIs into
# encrypted platform_service_keys rows. Other provider credentials likewise belong
# in their approved encrypted database-backed tables. Which transactional email
# provider is active at runtime is derived from the provider catalog joined to
# active platform_service_keys rows, never from this file.
Email__FromAddress=
Email__FromName=CROWNUS

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE__Swagger__Enabled=true

# Day planner (Planner = Calendar). Off by default; every planner endpoint answers
# 503 planner_disabled and the web app hides the Planner. appsettings.Development.json
# turns it on for local runs; set this on a staging or UAT host to turn it on there.
# Planner__Enabled=true
