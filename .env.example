# ONEVO Backend environment template
#
# Copy this file to .env for local development.
# .env is local and gitignored. Do not commit it.
# Real passwords belong only in .env or the host secret manager/environment.
#
# The API reads ordinary KEY=VALUE entries from .env without overwriting
# explicit process environment variables. It builds both .NET database
# connection strings from the atomic ONEVO_DB_* values below. Do not add full
# ConnectionStrings__DefaultConnection or ConnectionStrings__MigrationConnection
# assignments to this file or to .env.

# Local PostgreSQL
ONEVO_DB_HOST=localhost
ONEVO_DB_PORT=5432
ONEVO_DB_NAME=OnevoDb
ONEVO_DB_ADMIN_USER=postgres
ONEVO_DB_ADMIN_PASSWORD=<local-postgres-admin-password>

ONEVO_DB_APP_USER=onevo_app
ONEVO_DB_APP_PASSWORD=<local-runtime-password>

ONEVO_DB_MIGRATOR_USER=onevo_migrator
ONEVO_DB_MIGRATOR_PASSWORD=<local-migration-password>

# JWT signing keys (at least 32 characters each)
Jwt__Secret=
Jwt__AdminSecret=
Jwt__TenantIssuer=onevo-api
Jwt__TenantAudience=onevo-api
Jwt__AdminIssuer=onevo-platform-admin
Jwt__AdminAudience=onevo-platform-admin

# Encryption for secrets at rest
Encryption__MasterKey=<local-32-plus-character-random-secret>

# Public base URLs
Urls__AppBaseUrl=http://localhost:5173
Urls__AdminConsoleBaseUrl=http://localhost:5174
Urls__WebhookBaseUrl=

# CORS
AllowedOrigins__0=http://localhost:5173
AllowedOrigins__1=http://localhost:5174

# Email provider
Email__Provider=Resend
Email__FromAddress=
Email__FromName=ONEVO
Email__Smtp__Host=smtp.resend.com
Email__Smtp__Port=587
Email__Smtp__Username=resend
Email__Smtp__Password=
Email__Smtp__UseStartTls=true
Email__Resend__ApiKey=

# Google OAuth
GoogleAuth__Admin__ClientId=
GoogleAuth__Admin__ClientSecret=
GoogleAuth__TenantInvite__ClientId=
GoogleAuth__TenantInvite__ClientSecret=

# Stripe
Stripe__SecretKey=
Stripe__PublishableKey=
Stripe__WebhookSecret=

# PayHere
PayHere__MerchantId=
PayHere__MerchantSecret=
PayHere__WebhookSecret=
