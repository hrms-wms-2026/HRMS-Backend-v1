# ONEVO Backend local environment template
# Copy this file to the gitignored repository-root .env for local development.
# Keep real values only in local .env or an external secret manager.
#
# The API builds both .NET connection strings from these atomic ONEVO_DB_* values.
# Do not add full ConnectionStrings__* assignments.
ONEVO_DB_HOST=localhost
ONEVO_DB_PORT=5432
ONEVO_DB_NAME=OnevoDb
ONEVO_DB_ADMIN_USER=postgres
ONEVO_DB_ADMIN_PASSWORD=<local-postgres-admin-password>
ONEVO_DB_APP_USER=onevo_app
ONEVO_DB_APP_PASSWORD=<local-runtime-password>
ONEVO_DB_MIGRATOR_USER=onevo_migrator
ONEVO_DB_MIGRATOR_PASSWORD=<local-migration-password>

# Pre-database cryptographic inputs (use independent random values, 32+ characters).
Encryption__MasterKey=<local-32-plus-character-random-secret>
Jwt__Secret=<local-32-plus-character-random-secret-if-required>
Jwt__AdminSecret=<local-32-plus-character-random-secret-if-required>

# One-time Development/Test Developer Platform bootstrap input.
# DevAdmin__Password is used only when the configured platform user has no active
# password credential. After platform_user_credentials exists, login uses the DB
# password hash and startup no longer requires this value. Production must never
# depend on DevAdmin__Password.
PlatformBootstrap__SuperAdminEmail=dev@onevo.io
PlatformBootstrap__SuperAdminFullName=Development Super Admin
DevAdmin__Password=<one-time-local-dev-bootstrap-password>

# Non-secret email sender configuration. Provider API keys are not environment
# settings: save resend/sendgrid keys through the admin/system-config APIs into
# encrypted platform_service_keys rows. Other provider credentials likewise belong
# in their approved encrypted database-backed tables. Which transactional email
# provider is active at runtime is derived from the provider catalog joined to
# active platform_service_keys rows, never from this file.
Email__FromAddress=
Email__FromName=ONEVO

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE__Swagger__Enabled=true
