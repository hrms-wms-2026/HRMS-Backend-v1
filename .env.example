# ──────────────────────────────────────────────────────────────────────────────
#  ONEVO Backend — environment variable template
#
#  ASP.NET Core reads these via IConfiguration. The mapping is automatic:
#  every "__" (double underscore) becomes a ":" inside the appsettings tree.
#  e.g. Email__Resend__ApiKey  ==  Email:Resend:ApiKey  in appsettings.json.
#
#  Order of precedence (highest wins):
#    1. process environment variables (this file when sourced into your shell
#       or loaded by docker-compose / launchSettings)
#    2. appsettings.{Environment}.json
#    3. appsettings.json
#
#  Copy this file to `.env` and fill in real values for local development.
#  `.env` is gitignored. NEVER commit production secrets.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=onevo;Username=onevo;Password=onevo_dev

# ── JWT signing keys (must be ≥ 32 chars each) ────────────────────────────────
Jwt__Secret=
Jwt__AdminSecret=
Jwt__TenantIssuer=onevo-api
Jwt__TenantAudience=onevo-api
Jwt__AdminIssuer=onevo-platform-admin
Jwt__AdminAudience=onevo-platform-admin

# ── Encryption (used for secrets-at-rest, payment keys, etc.) ─────────────────
# Generate with: openssl rand -base64 32   (or any 32+ char random string)
# Required in production — omit only for local dev (falls back to NoOp/Base64).
Encryption__MasterKey=

# ── Public base URLs (used by invite/reset links + webhooks) ──────────────────
Urls__AppBaseUrl=http://localhost:5173
Urls__AdminConsoleBaseUrl=http://localhost:5174
Urls__WebhookBaseUrl=

# ── CORS (comma-separated list also acceptable in appsettings as JSON array) ──
# AllowedOrigins is consumed as an array; for env-var override use indexed keys.
AllowedOrigins__0=http://localhost:5173
AllowedOrigins__1=http://localhost:5174

# ── Email provider ────────────────────────────────────────────────────────────
# Provider = "Resend" | "Smtp" | "" (NoOp fallback with warning).
Email__Provider=Resend
Email__FromAddress=
Email__FromName=ONEVO

# Resend SMTP relay credentials (recommended). Resend SMTP password = your API key.
Email__Smtp__Host=smtp.resend.com
Email__Smtp__Port=587
Email__Smtp__Username=resend
Email__Smtp__Password=
Email__Smtp__UseStartTls=true

# Resend HTTP API (alternative — only one is required).
Email__Resend__ApiKey=

# ── Google OAuth ──────────────────────────────────────────────────────────────
GoogleAuth__Admin__ClientId=
GoogleAuth__Admin__ClientSecret=
GoogleAuth__TenantInvite__ClientId=
GoogleAuth__TenantInvite__ClientSecret=

# ── Stripe (subscription payments) ────────────────────────────────────────────
Stripe__SecretKey=
Stripe__PublishableKey=
Stripe__WebhookSecret=

# ── PayHere (Sri Lanka payments) ──────────────────────────────────────────────
PayHere__MerchantId=
PayHere__MerchantSecret=
PayHere__WebhookSecret=
